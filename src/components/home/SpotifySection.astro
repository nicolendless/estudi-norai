---
import { pageGutter } from '../../data/layout';
import { getTranslations, type Locale } from '../../i18n';
import CookieBlockedEmbed from '../shared/CookieBlockedEmbed.astro';

interface Props {
  locale: Locale;
  variant?: 'home' | 'subpage';
}

const { locale, variant = 'home' } = Astro.props;
const t = getTranslations(locale);

const iframeClass = 'h-[152px] w-full sm:h-[232px] md:h-[352px]';
---

<section id="spotify" class="bg-white py-10 md:py-14">
  <div class={pageGutter}>
    <div class="mx-auto w-full max-w-[1120px]">
      <CookieBlockedEmbed
        category="marketing"
        src="https://open.spotify.com/embed/playlist/6lFwLBYJZyImPdd8u8WwYU?utm_source=generator"
        title={t.spotify.title}
        wrapperClass={iframeClass}
        class={iframeClass}
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        placeholderTitle={t.spotify.title}
        placeholderText={t.spotify.placeholder}
        configureLabel={t.footer.configureCookies}
      />
    </div>
  </div>
</section>
