---
import { getTranslations, localizedPath, type Locale } from '../../i18n';
import LanguageSwitcher from '../shared/LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="menu" class="relative md:flex md:h-screen">
  <button
    type="button"
    aria-label={t.hero.openMenu}
    data-hero-menu-toggle
    class="fixed top-5 left-5 z-[60] inline-flex h-12 w-12 items-center justify-center rounded-full bg-amber-50/95 text-zinc-900 md:hidden"
  >
    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
    </svg>
  </button>

  <div
    class="fixed top-[5.25rem] right-4 z-[60] md:hidden"
    data-home-lang-switcher
  >
    <LanguageSwitcher
      locale={locale}
      currentPath={Astro.url.pathname}
      tone="light"
      class="language-switcher--light"
    />
  </div>

  <div class="relative h-[78vh] w-full md:h-full md:w-[65%]">
    <img
      src="/images/door_home_1.jpg"
      alt={t.hero.imageAlt}
      class="block h-full w-full object-cover object-[58%_50%] md:object-[50%_50%]"
    />
    <div class="absolute inset-0 flex items-center justify-center pr-4 pl-8 md:pr-8 md:pl-12">
      <h1 class="font-archivo text-center font-thin leading-tight text-white">
        <span class="block text-[clamp(1.25rem,3.5vw,2.5rem)] leading-[1.15]">
          {t.hero.h1Line1}
        </span>
        <span class="block text-[clamp(1.25rem,3.5vw,2.5rem)] leading-[1.15]">
          {t.hero.h1Line2}
        </span>
        <span class="mt-2 block text-[clamp(1rem,2vw,1.5625rem)]">{t.hero.h1Tagline}</span>
      </h1>
    </div>
  </div>
  <div class="relative hidden h-full w-[35%] overflow-hidden bg-amber-50 md:block">
    <div class="absolute top-8 left-8 z-20">
      <LanguageSwitcher locale={locale} currentPath={Astro.url.pathname} />
    </div>
    <nav aria-label={t.nav.ariaSections} class="font-archivo absolute inset-0 text-zinc-800">
      <svg
        width="255"
        height="306"
        viewBox="0 0 255 306"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        class="pointer-events-none absolute top-[25%] left-[26%] z-0 h-[50%] w-[56%]"
      >
        <path
          d="M0.428711 23.7282C2.91309 19.5912 169.679 -36.2718 143.929 41.7282C126.048 95.8925 236.09 135.557 252.929 142.728C128.929 156.728 7.73954 225.604 22.5537 204.596C85.9287 114.728 206.397 192.375 176.585 232.09C130.477 293.513 133.522 302.419 135.179 305.728"
          stroke="#202D35"></path>
        <path
          d="M251.544 142.823C211.211 149.823 139.944 154.023 177.544 114.823C215.144 75.6227 242.544 117.156 251.544 142.823Z"
          stroke="#202D35"></path>
      </svg>

      <a
        href={localizedPath('/servicios', locale)}
        class="group absolute top-[20%] left-[35%] z-10 text-center md:top-[21%]"
      >
        <span class="block text-[clamp(1.25rem,2.2vw,2.1rem)] leading-none group-hover:font-bold"
          >{t.hero.servicios}</span
        >
        <span class="-mt-0.5 block text-xs group-hover:font-bold md:text-sm">{t.hero.serviciosSub}</span>
      </a>

      <a href="#conoceme" class="group absolute top-[33%] left-[16%] z-10 text-center md:top-[35%]">
        <span class="block text-[clamp(1.2rem,2.1vw,2rem)] leading-none group-hover:font-bold"
          >{t.hero.bio}</span
        >
        <span class="-mt-0.5 block text-xs group-hover:font-bold md:text-sm">{t.hero.bioSub}</span>
      </a>

      <a
        href={localizedPath('/works', locale)}
        class="group absolute top-[53%] right-[8%] z-10 text-center"
      >
        <span class="block text-[clamp(1.25rem,2.2vw,2.1rem)] leading-none group-hover:font-bold"
          >{t.hero.proyectos}</span
        >
        <span class="-mt-0.5 block text-xs group-hover:font-bold md:text-sm">{t.hero.proyectosSub}</span>
      </a>

      <a
        href={localizedPath('/lestudi', locale)}
        class="group absolute top-[57%] left-[16%] z-10 text-center md:top-[60%]"
      >
        <span class="block text-[clamp(1.2rem,2.1vw,2rem)] leading-none group-hover:font-bold"
          >{t.hero.estudio}</span
        >
        <span class="-mt-0.5 block text-xs group-hover:font-bold md:text-sm">{t.hero.estudioSub}</span>
      </a>

      <a
        href="#contacto"
        class="group absolute bottom-[12%] left-1/2 z-10 -translate-x-1/2 text-center md:bottom-[14%]"
      >
        <span class="block text-[clamp(1.25rem,2.2vw,2.1rem)] leading-[0.9] group-hover:font-bold">
          {t.hero.trabajemos}
        </span>
        <span
          class="mt-1 block text-[clamp(1.25rem,2.2vw,2.1rem)] leading-[0.9] group-hover:font-bold"
        >
          {t.hero.trabajemosLine2}
        </span>
        <span class="-mt-0.5 block text-xs group-hover:font-bold md:text-sm">{t.hero.trabajemosSub}</span>
      </a>
    </nav>
  </div>

  <div id="hero-mobile-menu" class="fixed inset-0 z-50 hidden bg-amber-50 px-8 py-20 md:hidden">
    <div class="absolute top-5 right-5">
      <LanguageSwitcher locale={locale} currentPath={Astro.url.pathname} />
    </div>
    <button
      type="button"
      aria-label={t.hero.closeMenu}
      data-hero-menu-close
      class="fixed top-5 left-5 inline-flex h-12 w-12 items-center justify-center rounded-full bg-zinc-900 text-amber-50"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.9">
        <path d="M6 6l12 12M18 6l-12 12" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav class="font-archivo flex h-full flex-col items-start justify-center gap-5 text-zinc-900">
      <a
        href={localizedPath('/servicios', locale)}
        class="block w-full border-b border-zinc-900/20 pb-2 text-3xl"
        >{t.hero.mobileServicios}</a
      >
      <a href="#conoceme" class="block w-full border-b border-zinc-900/20 pb-2 text-3xl"
        >{t.hero.mobileBio}</a
      >
      <a
        href={localizedPath('/works', locale)}
        class="block w-full border-b border-zinc-900/20 pb-2 text-3xl">{t.hero.mobileProyectos}</a
      >
      <a
        href={localizedPath('/lestudi', locale)}
        class="block w-full border-b border-zinc-900/20 pb-2 text-3xl">{t.hero.mobileEstudio}</a
      >
      <a href="#contacto" class="block w-full border-b border-zinc-900/20 pb-2 text-3xl"
        >{t.hero.mobileTrabajemos}</a
      >
    </nav>
  </div>
</section>

<section id="footer-menu" class="w-full bg-cyan-950 py-2 md:absolute md:bottom-0 md:left-0 md:z-10">
  <div
    class="flex items-center justify-between gap-3 px-4 text-xs text-amber-50 md:px-8 md:text-lg"
  >
    <div class="text-left">+34 666 72 21 61</div>
    <div class="text-right">estudinorai@gmail.com</div>
  </div>
</section>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-hero-menu-toggle]');
  const menuClose = document.querySelector<HTMLButtonElement>('[data-hero-menu-close]');
  const mobileMenu = document.getElementById('hero-mobile-menu');
  const mobileLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#hero-mobile-menu a'),
  );

  const closeMenu = () => {
    if (!mobileMenu) return;
    mobileMenu.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    document.body.classList.remove('hero-menu-open');
    menuToggle?.classList.remove('invisible');
    window.dispatchEvent(new Event('scroll'));
  };

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      document.body.classList.add('hero-menu-open');
      menuToggle.classList.add('invisible');
      window.dispatchEvent(new Event('scroll'));
    });
  }

  if (menuClose) {
    menuClose.addEventListener('click', closeMenu);
  }

  mobileLinks.forEach((link) => link.addEventListener('click', closeMenu));
</script>
