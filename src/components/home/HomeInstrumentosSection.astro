---
import { pageGutter } from '../../data/layout';

/** Figma ICONES_FINALS — tira continua de 19 logos (4212×216). */
const logosStripSrc = '/images/instruments/icones-finals.png';
---

<section id="material" class="w-full bg-white py-10 md:py-14">
  <div class:list={[pageGutter, 'flex flex-col items-end']}>
    <div class="w-full max-w-[84.375rem] text-right">
      <h2 class="font-archivo text-[30px] leading-[1.09] font-light text-[#202d35]">
        Instrumentos y material disponible
      </h2>
      <a
        href="#contacto"
        class="font-archivo mt-2 inline-block text-[18px] leading-[1.09] text-[#202d35] underline"
      >
        Saber más
      </a>
    </div>
  </div>

  <div class="logos-bar mt-[15px]" aria-label="Logos de marcas de instrumentos">
    <div class="logos-bar__track">
      <img
        src={logosStripSrc}
        alt="Neumann, Apogee, Gibson, Fender, Heritage Audio y más marcas disponibles"
        class="logos-bar__strip"
        width={4096}
        height={210}
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .logos-bar {
    position: relative;
    overflow: hidden;
  }

  .logos-bar::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 1;
    width: clamp(4rem, 12vw, 8rem);
    background: linear-gradient(to right, transparent, #ffffff);
    pointer-events: none;
  }

  .logos-bar__track {
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-inline: clamp(1rem, 4vw, 6rem) clamp(4rem, 12vw, 8rem);
  }

  .logos-bar__track::-webkit-scrollbar {
    display: none;
  }

  .logos-bar__strip {
    display: block;
    height: clamp(4.5rem, 15vw, 13.5rem);
    width: auto;
    max-width: none;
  }
</style>
