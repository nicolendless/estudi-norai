---
import { getTranslations, localizedPath, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const cookiePolicyPath = localizedPath('/politica-de-cookies', locale);
---

<div
  id="cookie-consent-banner"
  class="fixed inset-x-0 bottom-0 z-[80] hidden border-t border-zinc-900/10 bg-[#f5efe6] px-4 py-5 shadow-[0_-8px_30px_rgba(0,0,0,0.08)] md:px-8"
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div class="max-w-3xl text-sm leading-relaxed text-zinc-800 md:text-base">
      <p id="cookie-consent-title" class="font-archivo mb-2 text-base font-normal md:text-lg">
        {t.cookies.bannerTitle}
      </p>
      <p id="cookie-consent-description">
        {t.cookies.bannerText}
        <a href={cookiePolicyPath} class="underline">{t.cookies.bannerPolicyLink}</a>.
      </p>
    </div>
    <div class="flex flex-wrap gap-2 md:justify-end">
      <button
        type="button"
        data-cookie-open-preferences
        class="font-archivo rounded-full border border-zinc-800 px-4 py-2 text-sm text-zinc-800 transition hover:bg-zinc-800 hover:text-[#f5efe6]"
      >
        {t.cookies.configure}
      </button>
      <button
        type="button"
        data-cookie-reject-all
        class="font-archivo rounded-full border border-zinc-800 px-4 py-2 text-sm text-zinc-800 transition hover:bg-zinc-800 hover:text-[#f5efe6]"
      >
        {t.cookies.reject}
      </button>
      <button
        type="button"
        data-cookie-accept-all
        class="font-archivo rounded-full bg-zinc-800 px-4 py-2 text-sm text-[#f5efe6] transition hover:bg-zinc-700"
      >
        {t.cookies.acceptAll}
      </button>
    </div>
  </div>
</div>

<div
  id="cookie-consent-modal"
  class="fixed inset-0 z-[90] hidden bg-zinc-900/50 px-4 py-8"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="cookie-preferences-title"
>
  <div class="mx-auto flex h-full max-w-2xl items-center justify-center">
    <div class="max-h-[90vh] w-full overflow-y-auto rounded-2xl bg-[#f5efe6] p-6 shadow-xl md:p-8">
      <div class="mb-6 flex items-start justify-between gap-4">
        <div>
          <h2 id="cookie-preferences-title" class="font-archivo text-xl font-normal text-zinc-800">
            {t.cookies.modalTitle}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-700">
            {t.cookies.modalDescription}
          </p>
        </div>
        <button
          type="button"
          data-cookie-close-modal
          class="font-archivo shrink-0 text-sm text-zinc-600 underline"
          aria-label={t.cookies.closeModalAria}
        >
          {t.cookies.closeModal}
        </button>
      </div>

      <ul class="space-y-4">
        {
          t.cookies.categories.map((category) => (
            <li class="rounded-xl border border-zinc-900/10 bg-white/60 p-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-archivo text-base text-zinc-800">{category.label}</p>
                  <p class="mt-1 text-sm leading-relaxed text-zinc-700">{category.description}</p>
                </div>
                {category.required ? (
                  <span class="font-archivo shrink-0 text-xs uppercase tracking-wide text-zinc-500">
                    {t.cookies.alwaysActive}
                  </span>
                ) : (
                  <label class="inline-flex shrink-0 cursor-pointer items-center gap-2">
                    <input
                      id={`cookie-toggle-${category.id}`}
                      type="checkbox"
                      class="h-4 w-4 accent-zinc-800"
                    />
                    <span class="sr-only">
                      {t.cookies.enableCategory} {category.label}
                    </span>
                  </label>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 flex flex-wrap gap-2">
        <button
          type="button"
          data-cookie-save-preferences
          class="font-archivo rounded-full bg-zinc-800 px-4 py-2 text-sm text-[#f5efe6] transition hover:bg-zinc-700"
        >
          {t.cookies.savePreferences}
        </button>
        <button
          type="button"
          data-cookie-accept-all
          class="font-archivo rounded-full border border-zinc-800 px-4 py-2 text-sm text-zinc-800 transition hover:bg-zinc-800 hover:text-[#f5efe6]"
        >
          {t.cookies.acceptAll}
        </button>
        <button
          type="button"
          data-cookie-reject-all
          class="font-archivo rounded-full border border-zinc-800 px-4 py-2 text-sm text-zinc-800 transition hover:bg-zinc-800 hover:text-[#f5efe6]"
        >
          {t.cookies.rejectOptional}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import '../../scripts/cookies';
</script>
