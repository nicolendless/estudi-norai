---
import { socialLinks } from '../../data/social';
import CookieBlockedEmbed from './CookieBlockedEmbed.astro';
---

<section id="visitanos" class="w-full bg-white">
  <div class="md:grid md:grid-cols-[55%_45%]">
    <div class="visitanos-map-column flex min-w-0 flex-col overflow-visible">
      <CookieBlockedEmbed
        category="marketing"
        src="https://www.google.com/maps?q=Carrer+del+Vi,+3A,+Palma&output=embed"
        title="Mapa Estudi Norai"
        wrapperClass="h-[420px] w-full md:h-[455px]"
        class="h-[420px] w-full border-0 md:h-[455px]"
        referrerPolicy="no-referrer-when-downgrade"
        placeholderTitle="Mapa de Google"
        placeholderText="Para mostrar el mapa necesitamos tu consentimiento para cargar contenido externo de Google Maps."
      />
      <div class="overflow-visible py-3 pr-3 md:py-4 md:pr-4">
        <h2
          class="font-archivo pointer-events-none w-full text-left text-[clamp(2.5rem,11.5vw,10.25rem)] leading-none font-light tracking-normal text-[#e5d9c7]"
        >
          VISÍTANOS
        </h2>
      </div>
    </div>

    <div
      class="relative flex min-h-0 flex-col items-end justify-end gap-6 px-6 py-8 md:min-h-[455px] md:gap-0 md:px-10 md:pb-10 md:py-0"
    >
      <a
        href="#contacto"
        class="group font-archivo hidden text-center text-[clamp(1.125rem,2vw,1.625rem)] leading-tight font-light text-[#202d35] sm:absolute sm:top-[42%] sm:left-[32%] sm:inline-block sm:-translate-x-1/2 sm:-translate-y-1/2 sm:-rotate-[15deg]"
      >
        <span class="block">o ponte</span>
        <span class="block"
          >en contacto<span class="ml-1 hidden group-hover:inline">:)</span></span
        >
      </a>
      <div class="font-archivo w-full text-right text-[clamp(1.125rem,4vw,1.875rem)] leading-tight font-light text-[#202d35]">
        <div class="mb-4 flex items-center justify-end" aria-label="Redes sociales">
          <a
            href={socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 block size-[34px] shrink-0"
            aria-label="Instagram de Estudi Norai"
          >
            <img src="/images/visitanos/instagram.svg" alt="" class="size-[34px]" loading="lazy" />
          </a>
          <a
            href={socialLinks.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-0 -ml-7 block h-9 w-[74px] shrink-0"
            aria-label="Canal de YouTube de Estudi Norai"
          >
            <img src="/images/visitanos/youtube.svg" alt="" class="h-9 w-[74px]" loading="lazy" />
          </a>
        </div>
        <p>Carrer del Vi, 3A</p>
        <p>Palma</p>
        <p>+34 666 72 21 61</p>
        <p>estudionorai@gmail.com</p>
      </div>
    </div>
  </div>
</section>
