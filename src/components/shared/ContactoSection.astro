---
const fieldClass =
  'font-archivo w-full rounded-full bg-[#f5efe6] px-6 py-3 text-center text-[#202d35] placeholder:text-[#202d35] outline-none';
const checkboxClass =
  'mt-0.5 size-4 shrink-0 appearance-none rounded-full border-0 bg-[#f5efe6] checked:bg-[#f5efe6]';

interface Props {
  showEmbarcate?: boolean;
}

const { showEmbarcate = true } = Astro.props;
---

<section
  id="contacto"
  class="relative flex min-h-[539px] w-full flex-col bg-[#202d35] pt-[83px] pb-[83px] lg:flex-row"
>
  <div class="order-2 flex w-full items-center justify-center px-4 md:px-16 lg:order-1 lg:w-1/2 lg:px-20 xl:px-24">
    <form action="/api/contact" method="post" data-contact-form class="w-full max-w-[423px] space-y-3">
      <input type="text" name="nombre" placeholder="Nombre*" required class={fieldClass} />
      <input type="email" name="email" placeholder="E-mail*" required class={fieldClass} />
      <input type="tel" name="telefono" placeholder="Teléfono" class={fieldClass} />

      <div class="relative">
        <textarea
          name="mensaje"
          rows="5"
          placeholder="Proyecto / Idea&#10;Déjame un mensaje"
          class="font-archivo w-full resize-none rounded-3xl bg-[#f5efe6] px-6 pt-5 pb-14 text-center text-[#202d35] placeholder:text-[#202d35] outline-none"
        ></textarea>
        <button
          type="submit"
          class="font-archivo absolute right-4 bottom-4 rounded-full bg-[#202d35] px-6 py-1.5 text-sm font-light text-[#f5efe6] hover:bg-[#2a3a45]"
        >
          Enviar
        </button>
      </div>

      <div class="space-y-3 pt-2 text-left text-sm font-light text-[#f5efe6] md:text-base">
        <label class="flex items-start gap-3">
          <input type="checkbox" name="politica" class={checkboxClass} required />
          <span>Acepto la política de protección de datos</span>
        </label>
        <label class="flex items-start gap-3">
          <input type="checkbox" name="comerciales" class={checkboxClass} />
          <span>Acepto recibir novedades comerciales</span>
        </label>
      </div>

      <p id="contact-feedback" class="hidden rounded-xl px-4 py-2 text-sm text-[#f5efe6]"></p>
    </form>
  </div>

  <div class="order-1 relative flex w-full items-center justify-center px-4 pb-8 md:px-16 md:pb-10 lg:order-2 lg:w-1/2 lg:px-20 lg:pb-0 xl:px-24">
    <h2
      class="font-archivo text-center text-[16vw] leading-[0.95] tracking-tight text-[#e5d9c7] sm:text-[14vw] md:text-[12vw] lg:text-[11vw] xl:text-[10vw]"
    >
      <span class="block">TRABA</span>
      <span class="block">JEMOS</span>
      <span class="block">JUNTOS</span>
    </h2>
  </div>

  {
    showEmbarcate && (
      <div class="absolute top-0 right-4 hidden pt-10 md:right-5 md:pt-14 lg:block">
        <span
          class="font-archivo inline-block text-base text-[#e5d9c7] [writing-mode:vertical-rl] md:text-lg lg:text-2xl"
        >
          Embárcate
        </span>
      </div>
    )
  }
</section>

<script>
  import '../../scripts/contact-form';
</script>
