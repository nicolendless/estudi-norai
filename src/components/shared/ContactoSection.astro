---
import { getTranslations, type Locale } from '../../i18n';

const fieldClass =
  'font-archivo w-full rounded-full bg-[#f5efe6] px-6 py-3 text-center text-[18px] font-light text-[#202d35] placeholder:text-[#202d35] outline-none shadow-[inset_0_0_4px_rgba(0,0,0,0.25)]';
const checkboxClass =
  'mt-1 h-[14px] w-[17px] shrink-0 cursor-pointer appearance-none rounded-full border-0 bg-[#f5efe6] checked:bg-[#f5efe6] shadow-[inset_0_0_4px_rgba(0,0,0,0.25)]';

interface Props {
  locale: Locale;
  showEmbarcate?: boolean;
}

const { locale, showEmbarcate = true } = Astro.props;
const t = getTranslations(locale);
---

<section
  id="contacto"
  class="relative flex min-h-0 w-full flex-col bg-[#202d35] pt-12 pb-12 md:min-h-[544px] md:pt-[83px] md:pb-[83px] lg:flex-row"
>
  <div class="order-2 flex w-full items-center justify-center px-4 md:px-16 lg:order-1 lg:w-1/2 lg:px-20 xl:px-24">
    <form
      action="/api/contact"
      method="post"
      data-contact-form
      data-msg-success={t.contact.success}
      data-msg-error={t.contact.error}
      data-msg-connection={t.contact.connectionError}
      data-msg-submitting={t.contact.submitting}
      data-msg-submit={t.contact.submit}
      class="w-full max-w-[423px] space-y-2"
    >
      <input type="hidden" name="locale" value={locale} />
      <input
        type="text"
        name="nombre"
        placeholder={t.contact.namePlaceholder}
        required
        class={fieldClass}
      />
      <input
        type="email"
        name="email"
        placeholder={t.contact.emailPlaceholder}
        required
        class={fieldClass}
      />
      <input type="tel" name="telefono" placeholder={t.contact.phonePlaceholder} class={fieldClass} />

      <div class="relative">
        <textarea
          name="mensaje"
          rows="5"
          placeholder={t.contact.messagePlaceholder}
          class="font-archivo w-full resize-none rounded-[28px] bg-[#f5efe6] px-6 pt-5 pb-14 text-center text-[18px] font-light text-[#202d35] placeholder:text-[#202d35] outline-none shadow-[inset_0_0_4px_rgba(0,0,0,0.25)]"
        ></textarea>
        <button
          type="submit"
          class="font-archivo absolute right-4 bottom-3 rounded-full bg-[#202d35] px-5 py-1 text-[13px] font-bold tracking-wide text-[#f5efe6] uppercase shadow-[inset_0_0_4px_rgba(0,0,0,0.25)] hover:bg-[#2a3a45]"
        >
          {t.contact.submit}
        </button>
      </div>

      <div class="space-y-1 pt-2 text-left text-base font-light text-[#f5efe6] sm:text-[18px]">
        <label class="flex items-start gap-3">
          <input type="checkbox" name="politica" class={checkboxClass} required />
          <span>{t.contact.privacyCheckbox}</span>
        </label>
        <label class="flex items-start gap-3">
          <input type="checkbox" name="comerciales" class={checkboxClass} />
          <span>{t.contact.marketingCheckbox}</span>
        </label>
      </div>

      <p id="contact-feedback" class="hidden rounded-xl px-4 py-2 text-sm text-[#f5efe6]"></p>
    </form>
  </div>

  <div class="order-1 relative flex w-full items-center justify-center px-6 pb-6 md:px-16 md:pb-10 lg:order-2 lg:w-1/2 lg:px-20 lg:pb-0 xl:px-24">
    <h2
      class="font-archivo text-center text-[clamp(2.5rem,11vw,10.3125rem)] leading-[0.95] font-light tracking-[-0.04em] text-[#e5d9c7]"
    >
      <span class="block">{t.contact.headingLine1}</span>
      <span class="block">{t.contact.headingLine2}</span>
    </h2>
  </div>

  {
    showEmbarcate && (
      <div class="absolute top-0 right-4 hidden pt-10 md:right-5 md:pt-14 lg:block">
        <span class="font-archivo inline-block text-[25px] font-normal text-[#e5d9c7] [writing-mode:vertical-rl]">
          {t.common.embarcate}
        </span>
      </div>
    )
  }
</section>

<script>
  import '../../scripts/contact-form';
</script>
