---
import { sessionsQuote, sessionsQuoteAuthor, sessionsThumb } from '../../data/works';
import { pageGutter, sectionTitleLg } from '../../data/layout';
---

<section id="norai-sessions" class="scroll-mt-6 bg-white pt-12 md:pt-[86px]">
  <div class={pageGutter}>
    <p class="font-archivo text-[clamp(1.125rem,3vw,1.875rem)] font-normal text-[#202d35]">last</p>
    <h2 class:list={[sectionTitleLg, 'mt-1 md:mt-2']}>Norai Sessions</h2>

    <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2 md:mt-[21px] lg:gap-[61px]">
      <div class="aspect-[588/347] overflow-hidden bg-zinc-100">
        <img
          src={sessionsThumb}
          alt="Norai Sessions"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="aspect-[588/347] overflow-hidden bg-zinc-100">
        <img
          src={sessionsThumb}
          alt="Norai Sessions"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>

    <blockquote
      class="font-archivo mx-auto mt-12 max-w-[762px] text-center text-[clamp(1rem,3.5vw,1.5625rem)] leading-relaxed font-extralight text-[#202d35] md:mt-[110px] md:leading-8"
    >
      {sessionsQuote}
      <span class="mt-2 block font-semibold">{sessionsQuoteAuthor}</span>
    </blockquote>
  </div>
</section>
