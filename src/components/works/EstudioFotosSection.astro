---
import { studioPhotos } from '../../data/works';
import {
  pageGutter,
  sectionTitleSplit,
  sectionTitleSplitPrimary,
  sectionTitleSplitSecondary,
} from '../../data/layout';
import { getTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="estudio-fotos" class="scroll-mt-6 bg-white pt-6 md:pt-[21px]">
  <div class={pageGutter}>
    <h2 class={sectionTitleSplit}>
      <span class={sectionTitleSplitPrimary}>{t.works.estudioTitle}</span>
      <span class={sectionTitleSplitSecondary}>{t.works.estudioMoments}</span>
    </h2>

    <div class="mt-8 grid grid-cols-2 gap-x-2 gap-y-2.5 sm:gap-x-2.5 sm:gap-y-3 md:mt-[63px] md:grid-cols-3">
      {
        studioPhotos.map((src) => (
          <div class="aspect-[350/435] overflow-hidden bg-zinc-100">
            <img src={src} alt="" class="h-full w-full object-cover" loading="lazy" />
          </div>
        ))
      }
    </div>
  </div>
</section>
