---
import { equipoBrandsImage } from '../../data/lestudi';
import { pageGutter, sectionTitleLestudi } from '../../data/layout';
import { getTranslations, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="equipo" class="scroll-mt-6 bg-white py-10 md:py-14">
  <div class={pageGutter}>
    <h2 class={sectionTitleLestudi}>{t.lestudi.equipoTitle}</h2>

    <div class="mt-8 overflow-hidden">
      <img
        src={equipoBrandsImage}
        alt={t.lestudi.equipoAlt}
        class="w-full object-contain"
        loading="lazy"
      />
    </div>
  </div>
</section>
