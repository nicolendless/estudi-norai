---
interface Props {
  active?: 'servicios';
}

const { active } = Astro.props;

const links = [
  { href: '/servicios', label: 'SERVICIOS', key: 'servicios' as const },
  { href: '/#embarcacion', label: "L'ESTUDI", key: null },
  { href: '/#artistas', label: 'WORKS', key: null },
];
---

<header class="border-b border-zinc-200 bg-white">
  <div
    class="mx-4 flex flex-col gap-6 py-6 md:mx-16 md:flex-row md:items-center md:justify-between md:py-8 lg:mx-20 xl:mx-24"
  >
    <a href="/" class="shrink-0">
      <img
        src="/images/logo.svg"
        alt="Estudi Norai"
        class="site-logo site-logo-dark h-14 w-auto md:h-[4.5rem]"
      />
    </a>

    <nav aria-label="Principal" class="flex flex-wrap items-center gap-6 md:gap-12 lg:gap-20">
      {
        links.map(({ href, label, key }) => (
          <a
            href={href}
            class:list={[
              'font-archivo text-[clamp(1.25rem,3vw,1.875rem)] text-[#202d35]',
              active === key ? 'font-semibold underline' : key === null && label === 'WORKS' ? 'font-light' : 'font-extralight',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
