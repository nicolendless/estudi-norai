---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const seo = {
  title: 'Página no encontrada — Estudi Norai',
  description: 'La página que buscas no existe. Vuelve al inicio de Estudi Norai, estudio de grabación en Palma de Mallorca.',
  path: '/404',
  noindex: true,
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  noindex={true}
  hideHeaderLogo
>
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-6 py-20 text-center">
    <p class="font-archivo text-sm uppercase tracking-[0.2em] text-zinc-500">404</p>
    <h1 class="mt-4 font-archivo text-[clamp(1.75rem,5vw,2.5rem)] font-light text-zinc-900">
      Página no encontrada
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-zinc-700">
      No hemos encontrado la página que buscas. Puedes volver al inicio o explorar nuestros
      servicios y salas de grabación.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="font-archivo underline">Ir al inicio</a>
      <a href="/servicios" class="font-archivo underline">Ver servicios</a>
      <a href="/lestudi" class="font-archivo underline">Conocer l'estudi</a>
    </div>
  </section>
</BaseLayout>
