---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/shared/SiteNav.astro';
import TripulacionSection from '../../components/works/TripulacionSection.astro';
import EstudioFotosSection from '../../components/works/EstudioFotosSection.astro';
import NoraiSessionsSection from '../../components/works/NoraiSessionsSection.astro';
import SpotifySection from '../../components/home/SpotifySection.astro';
import ContactoSection from '../../components/shared/ContactoSection.astro';
import VisitanosSection from '../../components/shared/VisitanosSection.astro';
export const prerender = true;
---

<BaseLayout seoKey="works" logoMode="fixed-dark" hideHeaderLogo>
  <SiteNav active="works" />
  <h1 class="sr-only">Works, artistas y proyectos musicales en Estudi Norai</h1>
  <TripulacionSection />
  <EstudioFotosSection />
  <NoraiSessionsSection />
  <SpotifySection variant="subpage" />
  <ContactoSection />
  <VisitanosSection />
</BaseLayout>
