---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiciosNav from '../../components/servicios/ServiciosNav.astro';
import ServicioBlock from '../../components/servicios/ServicioBlock.astro';
import MaterialSection from '../../components/home/MaterialSection.astro';
import ContactoSection from '../../components/shared/ContactoSection.astro';
import VisitanosSection from '../../components/shared/VisitanosSection.astro';
import { services } from '../../data/services';
---

<BaseLayout title="Servicios — Estudi Norai" logoMode="fixed-dark" hideHeaderLogo>
  <ServiciosNav active="servicios" />
  {services.map((service) => (
    <ServicioBlock {...service} />
  ))}
  <MaterialSection />
  <ContactoSection />
  <VisitanosSection />
</BaseLayout>

<script>
  const scrollToHash = () => {
    const { hash } = window.location;
    if (!hash) return;

    const target = document.querySelector<HTMLElement>(hash);
    if (!target) return;

    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  scrollToHash();
  window.addEventListener('hashchange', scrollToHash);
</script>
